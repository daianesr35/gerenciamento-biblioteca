# Valores públicos disponibilizados pelo painel do projeto Supabase.
# A publishable key pode ser usada no navegador; nunca use secret/service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_este_exemplo

# URL canônica da aplicação em cada ambiente.
NEXT_PUBLIC_APP_URL=http://localhost:3000
